# Local dev (supabase start) values live in .env
# PORT is only used by `npm run dev` (plain local server). Vercel serves the
# Express app as a function, so PORT is ignored there.
PORT=4000
NODE_ENV=development

# Postgres connection. On Vercel use Supabase's transaction pooler URL
# (host ends in `-pooler.supabase.com`, port 6543) to keep connection counts
# low across cold starts. Locally this is the `supabase start` DB URL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Optional: a separate URL the test suite runs against (falls back to
# DATABASE_URL). On the same Supabase project as the dev DB, tests delete
# rows from the app tables, so a dedicated project/schema is cleaner.
DATABASE_URL_TEST=

# Supabase project details (URL with protocol, and the two JWT keys from
# Project Settings -> API).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Safe Mind <no-reply@safemind.app>"

# Public origin of the frontend (used in the password reset email link).
APP_URL=http://localhost:3000

# Optional: Google OAuth client id, only needed to auto-link Google sign-in to
# an existing password account with the same email. Google login works without it.
GOOGLE_CLIENT_ID=